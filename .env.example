GROQ_API_KEY=
GEMINI_API_KEY=
# Existing deployments may use GOOGLE_API_KEY instead.
GOOGLE_API_KEY=
# Hosted Gemini embedding model (no local embedding model is downloaded).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional Gemini model override, for example: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
# Optional Groq model override. Groq is tried before Gemini when configured.
GROQ_MODEL=qwen/qwen3.8-27b
# One or more HTML sources, separated by commas.
KNOWLEDGE_URLS=https://www.fao.org/4/AC171E/AC171E00.htm#ch1
